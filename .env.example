# ─── Database (Supabase) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── NextAuth v5 ──────────────────────────────────────────────────
# NextAuth v5 uses AUTH_URL and AUTH_SECRET (not NEXTAUTH_URL/NEXTAUTH_SECRET)
# In production on Vercel, set AUTH_URL to your deployment URL (e.g. https://your-app.vercel.app)
# Vercel automatically sets VERCEL_URL; NextAuth v5 will use that as fallback if AUTH_URL is unset.
AUTH_URL="http://localhost:4000"
AUTH_SECRET=""   # openssl rand -base64 32

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Claude AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Encryption ───────────────────────────────────────────────────
ENCRYPTION_KEY=""    # 32-byte hex string for AES-256-GCM
